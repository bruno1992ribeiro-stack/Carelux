generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////////

enum SubscriptionPlan {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  CANCELLED
}

enum FacilityStatus {
  ACTIVE
  INACTIVE
}

enum ResidentStatus {
  ACTIVE
  HOSPITALIZED
  DISCHARGED
  DECEASED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ClinicalItemStatus {
  ACTIVE
  INACTIVE
}

enum AllergyType {
  MEDICATION
  FOOD
  ENVIRONMENTAL
  CONTACT
  OTHER
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
  LIFE_THREATENING
}

enum ClinicalRecordCategory {
  MEDICAL
  NURSING
  PHYSIOTHERAPY
  OCCUPATIONAL_THERAPY
  SPEECH_THERAPY
  PSYCHOLOGY
  NUTRITION
  SOCIAL_WORK
  AUDIOLOGY
  OTHER
}

enum ClinicalRecordStatus {
  ACTIVE
  VOIDED
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AppointmentRevisionType {
  EDITED
  RESCHEDULED
  COMPLETED
  CANCELLED
  REOPENED
  STATUS_CORRECTED
}

enum MedicationStatus {
  ACTIVE
  SUSPENDED
  DISCONTINUED
}

enum MedicationScheduleMode {
  DAILY_FREQUENCY
  FIXED_TIMES
  CARE_MOMENTS
  INTERVAL
  PRN
}

enum MedicationCareMoment {
  BREAKFAST
  LUNCH
  DINNER
  BEDTIME
}

enum MedicationWeekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum MedicationRevisionType {
  EDITED
  SCHEDULE_CHANGED
  SUSPENDED
  REACTIVATED
  DISCONTINUED
  STATUS_CORRECTED
}

//////////////////////////////////////////////////////////
// CLIENT
//////////////////////////////////////////////////////////

model Client {
  id String @id @default(uuid()) @db.Uuid

  name  String
  email String  @unique
  phone String?
  nif   String?

  subscriptionPlan   SubscriptionPlan   @default(FREE)
  subscriptionStatus SubscriptionStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  facilities Facility[]
  users      User[]
  roles      Role[]

  @@index([email])
}

//////////////////////////////////////////////////////////
// FACILITY
//////////////////////////////////////////////////////////

model Facility {
  id String @id @default(uuid()) @db.Uuid

  clientId String @db.Uuid

  name String

  address    String?
  city       String?
  postalCode String?

  phone String?
  email String?

  status FacilityStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  users                        User[]
  familyMembers                FamilyMember[]
  rooms                        Room[]
  residents                    Resident[]
  clinicalRecords              ResidentClinicalRecord[]
  appointments                 ResidentAppointment[]
  medications                  ResidentMedication[]
  medicationRevisionsChangedAt ResidentMedicationRevision[] @relation("MedicationRevisionChangedAtFacility")

  @@index([clientId])
}

//////////////////////////////////////////////////////////
// ROOM
//////////////////////////////////////////////////////////

model Room {
  id String @id @default(uuid()) @db.Uuid

  facilityId String @db.Uuid

  number String

  floor String?

  capacity Int @default(1)

  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  beds Bed[]

  residents Resident[]

  @@unique([facilityId, number])
}

//////////////////////////////////////////////////////////
// BED
//////////////////////////////////////////////////////////

model Bed {
  id String @id @default(uuid()) @db.Uuid

  roomId String @db.Uuid

  identifier String

  active Boolean @default(true)

  occupied Boolean @default(false)

  room Room @relation(fields: [roomId], references: [id], onDelete: Restrict)

  residents Resident[]
}

//////////////////////////////////////////////////////////
// RESIDENT
//////////////////////////////////////////////////////////

model Resident {
  id String @id @default(uuid()) @db.Uuid

  facilityId String @db.Uuid

  roomId String? @db.Uuid

  bedId String? @db.Uuid

  firstName String

  lastName String

  birthDate DateTime?

  gender Gender?

  admissionDate DateTime?

  roomNumber String?

  status ResidentStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  room Room? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  bed Bed? @relation(fields: [bedId], references: [id], onDelete: SetNull)

  contacts        ResidentContact[]
  familyMembers   FamilyMember[]
  diagnoses       ResidentDiagnosis[]
  allergies       ResidentAllergy[]
  clinicalRecords ResidentClinicalRecord[]
  appointments    ResidentAppointment[]
  medications     ResidentMedication[]

  @@index([facilityId])
  @@index([roomId])
  @@index([bedId])
}

//////////////////////////////////////////////////////////
// FAMILY MEMBER
//////////////////////////////////////////////////////////

model FamilyMember {
  id String @id @default(uuid()) @db.Uuid

  facilityId String @db.Uuid

  residentId String @db.Uuid

  fullName String

  relationship String

  email String?

  phone String?

  isPrimaryContact Boolean @default(false)

  legalRepresentative Boolean @default(false)

  notes String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  resident Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([facilityId, residentId])
  @@index([residentId, isPrimaryContact])
}

//////////////////////////////////////////////////////////
// RESIDENT CONTACT
//////////////////////////////////////////////////////////

model ResidentContact {
  id String @id @default(uuid()) @db.Uuid

  residentId String @db.Uuid

  fullName String

  relationship String

  phone String?

  email String?

  isPrimary Boolean @default(false)

  legalRepresentative Boolean @default(false)

  notes String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  resident Resident @relation(fields: [residentId], references: [id], onDelete: Restrict)

  @@index([residentId])
}

//////////////////////////////////////////////////////////
// RESIDENT DIAGNOSIS
//////////////////////////////////////////////////////////

model ResidentDiagnosis {
  id String @id @default(uuid()) @db.Uuid

  residentId  String @db.Uuid
  createdById String @db.Uuid

  name         String
  description  String?
  diagnosedAt  DateTime?
  status       ClinicalItemStatus @default(ACTIVE)
  observations String?

  deactivatedAt   DateTime?
  deactivatedById String?   @db.Uuid
  supersedesId    String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resident      Resident @relation(fields: [residentId], references: [id], onDelete: Restrict)
  createdBy     User     @relation("DiagnosisCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  deactivatedBy User?    @relation("DiagnosisDeactivatedBy", fields: [deactivatedById], references: [id], onDelete: Restrict)

  supersedes  ResidentDiagnosis?  @relation("DiagnosisCorrections", fields: [supersedesId], references: [id], onDelete: Restrict)
  corrections ResidentDiagnosis[] @relation("DiagnosisCorrections")

  @@index([residentId, status])
  @@index([createdById])
  @@index([supersedesId])
}

//////////////////////////////////////////////////////////
// RESIDENT ALLERGY
//////////////////////////////////////////////////////////

model ResidentAllergy {
  id String @id @default(uuid()) @db.Uuid

  residentId  String @db.Uuid
  createdById String @db.Uuid

  allergen     String
  type         AllergyType?
  reaction     String
  severity     AllergySeverity
  observations String?
  status       ClinicalItemStatus @default(ACTIVE)

  deactivatedAt   DateTime?
  deactivatedById String?   @db.Uuid
  supersedesId    String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resident      Resident @relation(fields: [residentId], references: [id], onDelete: Restrict)
  createdBy     User     @relation("AllergyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  deactivatedBy User?    @relation("AllergyDeactivatedBy", fields: [deactivatedById], references: [id], onDelete: Restrict)

  supersedes  ResidentAllergy?  @relation("AllergyCorrections", fields: [supersedesId], references: [id], onDelete: Restrict)
  corrections ResidentAllergy[] @relation("AllergyCorrections")

  @@index([residentId, status])
  @@index([createdById])
  @@index([supersedesId])
}

//////////////////////////////////////////////////////////
// RESIDENT CLINICAL RECORD
//////////////////////////////////////////////////////////

model ResidentClinicalRecord {
  id String @id @default(uuid()) @db.Uuid

  residentId   String @db.Uuid
  facilityId   String @db.Uuid
  authorUserId String @db.Uuid

  category   ClinicalRecordCategory
  title      String
  content    String
  clinicalAt DateTime

  status ClinicalRecordStatus @default(ACTIVE)

  voidedAt       DateTime?
  voidedById     String?   @db.Uuid
  voidReason     String?
  amendsRecordId String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resident   Resident @relation(fields: [residentId], references: [id], onDelete: Restrict)
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  authorUser User     @relation("ClinicalRecordAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  voidedBy   User?    @relation("ClinicalRecordVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)

  amendsRecord ResidentClinicalRecord?  @relation("ClinicalRecordAmendments", fields: [amendsRecordId], references: [id], onDelete: Restrict)
  amendments   ResidentClinicalRecord[] @relation("ClinicalRecordAmendments")

  @@index([residentId, clinicalAt])
  @@index([facilityId, clinicalAt])
  @@index([authorUserId])
  @@index([amendsRecordId])
  @@index([status])
}

//////////////////////////////////////////////////////////
// RESIDENT APPOINTMENT
//////////////////////////////////////////////////////////

model ResidentAppointment {
  id String @id @default(uuid()) @db.Uuid

  residentId        String  @db.Uuid
  facilityId        String  @db.Uuid
  createdById       String  @db.Uuid
  lastModifiedById  String  @db.Uuid
  responsibleUserId String? @db.Uuid

  professionalName String
  scheduledAt      DateTime
  type             String
  specialty        String?
  location         String?
  reason           String?
  observations     String?
  status           AppointmentStatus @default(SCHEDULED)

  completedAt        DateTime?
  completedById      String?   @db.Uuid
  cancelledAt        DateTime?
  cancelledById      String?   @db.Uuid
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resident        Resident @relation(fields: [residentId], references: [id], onDelete: Restrict)
  facility        Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  createdBy       User     @relation("AppointmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  lastModifiedBy  User     @relation("AppointmentLastModifiedBy", fields: [lastModifiedById], references: [id], onDelete: Restrict)
  responsibleUser User?    @relation("AppointmentResponsibleUser", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  completedBy     User?    @relation("AppointmentCompletedBy", fields: [completedById], references: [id], onDelete: Restrict)
  cancelledBy     User?    @relation("AppointmentCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)

  revisions ResidentAppointmentRevision[]

  @@index([residentId, status, scheduledAt])
  @@index([residentId, scheduledAt])
  @@index([facilityId, scheduledAt])
  @@index([responsibleUserId, scheduledAt])
  @@index([status, scheduledAt])
}

//////////////////////////////////////////////////////////
// RESIDENT APPOINTMENT REVISION
//////////////////////////////////////////////////////////

model ResidentAppointmentRevision {
  id String @id @default(uuid()) @db.Uuid

  appointmentId String                  @db.Uuid
  changedById   String                  @db.Uuid
  changeType    AppointmentRevisionType
  changeReason  String?

  scheduledAt       DateTime
  status            AppointmentStatus
  type              String
  specialty         String?
  professionalName  String
  responsibleUserId String?           @db.Uuid
  location          String?
  reason            String?
  observations      String?

  completedAt        DateTime?
  completedById      String?   @db.Uuid
  cancelledAt        DateTime?
  cancelledById      String?   @db.Uuid
  cancellationReason String?

  changedAt DateTime @default(now())

  appointment     ResidentAppointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  changedBy       User                @relation("AppointmentRevisionChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  responsibleUser User?               @relation("AppointmentRevisionResponsibleUser", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  completedBy     User?               @relation("AppointmentRevisionCompletedBy", fields: [completedById], references: [id], onDelete: Restrict)
  cancelledBy     User?               @relation("AppointmentRevisionCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)

  @@index([appointmentId, changedAt])
  @@index([changedById])
  @@index([responsibleUserId])
  @@index([changeType])
}

//////////////////////////////////////////////////////////
// RESIDENT MEDICATION
//////////////////////////////////////////////////////////

model ResidentMedication {
  id String @id @default(uuid()) @db.Uuid

  residentId       String  @db.Uuid
  facilityId       String  @db.Uuid
  createdById      String  @db.Uuid
  lastModifiedById String  @db.Uuid
  prescriberUserId String? @db.Uuid

  prescriberName      String
  medicationName      String
  dosage              String
  pharmaceuticalForm  String
  administrationRoute String
  indication          String?
  observations        String?
  startDate           DateTime         @db.Date
  endDate             DateTime?        @db.Date
  status              MedicationStatus @default(ACTIVE)

  suspendedAt           DateTime?
  suspendedById         String?   @db.Uuid
  suspensionReason      String?
  discontinuedAt        DateTime?
  discontinuedById      String?   @db.Uuid
  discontinuationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resident       Resident @relation(fields: [residentId], references: [id], onDelete: Restrict)
  facility       Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  createdBy      User     @relation("MedicationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  lastModifiedBy User     @relation("MedicationLastModifiedBy", fields: [lastModifiedById], references: [id], onDelete: Restrict)
  prescriberUser User?    @relation("MedicationPrescriber", fields: [prescriberUserId], references: [id], onDelete: Restrict)
  suspendedBy    User?    @relation("MedicationSuspendedBy", fields: [suspendedById], references: [id], onDelete: Restrict)
  discontinuedBy User?    @relation("MedicationDiscontinuedBy", fields: [discontinuedById], references: [id], onDelete: Restrict)

  scheduleRules ResidentMedicationScheduleRule[]
  revisions     ResidentMedicationRevision[]

  @@index([residentId, status, startDate])
  @@index([residentId, startDate])
  @@index([facilityId, status])
  @@index([prescriberUserId])
  @@index([status, endDate])
}

//////////////////////////////////////////////////////////
// RESIDENT MEDICATION SCHEDULE
//////////////////////////////////////////////////////////

model ResidentMedicationScheduleRule {
  id String @id @default(uuid()) @db.Uuid

  medicationId         String                 @db.Uuid
  mode                 MedicationScheduleMode
  timesPerDay          Int?
  intervalHours        Int?
  /// An empty list means that the rule applies every day.
  weekdays             MedicationWeekday[]    @default([])
  prnReason            String?
  maxDosesPerDay       Int?
  minimumIntervalHours Int?
  instructions         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medication  ResidentMedication                     @relation(fields: [medicationId], references: [id], onDelete: Restrict)
  occurrences ResidentMedicationScheduleOccurrence[]

  @@index([medicationId])
  @@index([mode])
}

model ResidentMedicationScheduleOccurrence {
  id String @id @default(uuid()) @db.Uuid

  scheduleRuleId String                @db.Uuid
  timeOfDay      DateTime?             @db.Time(0)
  careMoment     MedicationCareMoment?
  doseOverride   String?
  position       Int

  scheduleRule ResidentMedicationScheduleRule @relation(fields: [scheduleRuleId], references: [id], onDelete: Restrict)

  @@unique([scheduleRuleId, position], map: "ResidentMedicationScheduleOccurrence_scheduleRuleId_position_ke")
  @@index([scheduleRuleId, timeOfDay], map: "ResidentMedicationScheduleOccurrence_scheduleRuleId_timeOfDay_i")
  @@index([scheduleRuleId, careMoment], map: "ResidentMedicationScheduleOccurrence_scheduleRuleId_careMoment_")
}

//////////////////////////////////////////////////////////
// RESIDENT MEDICATION REVISION
//////////////////////////////////////////////////////////

model ResidentMedicationRevision {
  id String @id @default(uuid()) @db.Uuid

  medicationId        String                 @db.Uuid
  changedById         String                 @db.Uuid
  changedAtFacilityId String                 @db.Uuid
  changeType          MedicationRevisionType
  changeReason        String?

  prescriberUserId    String?          @db.Uuid
  prescriberName      String
  medicationName      String
  dosage              String
  pharmaceuticalForm  String
  administrationRoute String
  indication          String?
  observations        String?
  startDate           DateTime         @db.Date
  endDate             DateTime?        @db.Date
  status              MedicationStatus

  suspendedAt           DateTime?
  suspendedById         String?   @db.Uuid
  suspensionReason      String?
  discontinuedAt        DateTime?
  discontinuedById      String?   @db.Uuid
  discontinuationReason String?

  scheduleSnapshot        Json
  scheduleSnapshotVersion Int      @default(1)
  changedAt               DateTime @default(now())

  medication        ResidentMedication @relation(fields: [medicationId], references: [id], onDelete: Restrict)
  changedBy         User               @relation("MedicationRevisionChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  changedAtFacility Facility           @relation("MedicationRevisionChangedAtFacility", fields: [changedAtFacilityId], references: [id], onDelete: Restrict)
  prescriberUser    User?              @relation("MedicationRevisionPrescriber", fields: [prescriberUserId], references: [id], onDelete: Restrict)
  suspendedBy       User?              @relation("MedicationRevisionSuspendedBy", fields: [suspendedById], references: [id], onDelete: Restrict)
  discontinuedBy    User?              @relation("MedicationRevisionDiscontinuedBy", fields: [discontinuedById], references: [id], onDelete: Restrict)

  @@index([medicationId, changedAt])
  @@index([changedById])
  @@index([changedAtFacilityId])
  @@index([changeType])
}

//////////////////////////////////////////////////////////
// AUTH.JS
//////////////////////////////////////////////////////////

model Account {
  id String @id @default(cuid())

  userId String @db.Uuid

  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id String @id @default(cuid())

  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

//////////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////////

model User {
  id String @id @default(uuid()) @db.Uuid

  clientId String? @db.Uuid

  facilityId String? @db.Uuid

  roleId String @db.Uuid

  fullName String

  email String @unique

  emailVerified DateTime?
  image         String?

  password String

  active Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  facility Facility? @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  accounts                        Account[]
  sessions                        Session[]
  diagnosesCreated                ResidentDiagnosis[]           @relation("DiagnosisCreatedBy")
  diagnosesDeactivated            ResidentDiagnosis[]           @relation("DiagnosisDeactivatedBy")
  allergiesCreated                ResidentAllergy[]             @relation("AllergyCreatedBy")
  allergiesDeactivated            ResidentAllergy[]             @relation("AllergyDeactivatedBy")
  clinicalRecordsAuthored         ResidentClinicalRecord[]      @relation("ClinicalRecordAuthor")
  clinicalRecordsVoided           ResidentClinicalRecord[]      @relation("ClinicalRecordVoidedBy")
  appointmentsCreated             ResidentAppointment[]         @relation("AppointmentCreatedBy")
  appointmentsLastModified        ResidentAppointment[]         @relation("AppointmentLastModifiedBy")
  appointmentsResponsible         ResidentAppointment[]         @relation("AppointmentResponsibleUser")
  appointmentsCompleted           ResidentAppointment[]         @relation("AppointmentCompletedBy")
  appointmentsCancelled           ResidentAppointment[]         @relation("AppointmentCancelledBy")
  appointmentRevisionsChanged     ResidentAppointmentRevision[] @relation("AppointmentRevisionChangedBy")
  appointmentRevisionsResponsible ResidentAppointmentRevision[] @relation("AppointmentRevisionResponsibleUser")
  appointmentRevisionsCompleted   ResidentAppointmentRevision[] @relation("AppointmentRevisionCompletedBy")
  appointmentRevisionsCancelled   ResidentAppointmentRevision[] @relation("AppointmentRevisionCancelledBy")
  medicationsCreated              ResidentMedication[]          @relation("MedicationCreatedBy")
  medicationsLastModified         ResidentMedication[]          @relation("MedicationLastModifiedBy")
  medicationsPrescribed           ResidentMedication[]          @relation("MedicationPrescriber")
  medicationsSuspended            ResidentMedication[]          @relation("MedicationSuspendedBy")
  medicationsDiscontinued         ResidentMedication[]          @relation("MedicationDiscontinuedBy")
  medicationRevisionsChanged      ResidentMedicationRevision[]  @relation("MedicationRevisionChangedBy")
  medicationRevisionsPrescribed   ResidentMedicationRevision[]  @relation("MedicationRevisionPrescriber")
  medicationRevisionsSuspended    ResidentMedicationRevision[]  @relation("MedicationRevisionSuspendedBy")
  medicationRevisionsDiscontinued ResidentMedicationRevision[]  @relation("MedicationRevisionDiscontinuedBy")

  @@index([clientId])
  @@index([facilityId])
  @@index([roleId])
}

//////////////////////////////////////////////////////////
// ROLES
//////////////////////////////////////////////////////////

model Role {
  id String @id @default(uuid()) @db.Uuid

  clientId String? @db.Uuid

  code String @unique

  name String

  description String?

  isSystem Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  users User[]

  permissions RolePermission[]

  @@index([clientId])
}

//////////////////////////////////////////////////////////
// PERMISSIONS
//////////////////////////////////////////////////////////

model Permission {
  id String @id @default(uuid()) @db.Uuid

  code String @unique

  name String

  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles RolePermission[]
}

//////////////////////////////////////////////////////////
// ROLE PERMISSION
//////////////////////////////////////////////////////////

model RolePermission {
  id String @id @default(uuid()) @db.Uuid

  roleId String @db.Uuid

  permissionId String @db.Uuid

  createdAt DateTime @default(now())

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}
