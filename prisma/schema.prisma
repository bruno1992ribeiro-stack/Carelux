generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////////

enum SubscriptionPlan {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  CANCELLED
}

enum FacilityStatus {
  ACTIVE
  INACTIVE
}

enum ResidentStatus {
  ACTIVE
  HOSPITALIZED
  DISCHARGED
  DECEASED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

//////////////////////////////////////////////////////////
// CLIENT
//////////////////////////////////////////////////////////

model Client {
  id String @id @default(uuid()) @db.Uuid

  name  String
  email String  @unique
  phone String?
  nif   String?

  subscriptionPlan   SubscriptionPlan   @default(FREE)
  subscriptionStatus SubscriptionStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  facilities Facility[]
  users      User[]
  roles      Role[]

  @@index([email])
}

//////////////////////////////////////////////////////////
// FACILITY
//////////////////////////////////////////////////////////

model Facility {
  id String @id @default(uuid()) @db.Uuid

  clientId String @db.Uuid

  name String

  address    String?
  city       String?
  postalCode String?

  phone String?
  email String?

  status FacilityStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  users         User[]
  familyMembers FamilyMember[]
  rooms         Room[]
  residents     Resident[]

  @@index([clientId])
}

//////////////////////////////////////////////////////////
// ROOM
//////////////////////////////////////////////////////////

model Room {
  id String @id @default(uuid()) @db.Uuid

  facilityId String @db.Uuid

  number String

  floor String?

  capacity Int @default(1)

  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  beds Bed[]

  residents Resident[]

  @@unique([facilityId, number])
}

//////////////////////////////////////////////////////////
// BED
//////////////////////////////////////////////////////////

model Bed {
  id String @id @default(uuid()) @db.Uuid

  roomId String @db.Uuid

  identifier String

  active Boolean @default(true)

  occupied Boolean @default(false)

  room Room @relation(fields: [roomId], references: [id], onDelete: Restrict)

  residents Resident[]
}

//////////////////////////////////////////////////////////
// RESIDENT
//////////////////////////////////////////////////////////

model Resident {
  id String @id @default(uuid()) @db.Uuid

  facilityId String @db.Uuid

  roomId String? @db.Uuid

  bedId String? @db.Uuid

  firstName String

  lastName String

  birthDate DateTime?

  gender Gender?

  admissionDate DateTime?

  roomNumber String?

  status ResidentStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  room Room? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  bed Bed? @relation(fields: [bedId], references: [id], onDelete: SetNull)

  contacts      ResidentContact[]
  familyMembers FamilyMember[]

  @@index([facilityId])
  @@index([roomId])
  @@index([bedId])
}

//////////////////////////////////////////////////////////
// FAMILY MEMBER
//////////////////////////////////////////////////////////

model FamilyMember {
  id String @id @default(uuid()) @db.Uuid

  facilityId String @db.Uuid

  residentId String @db.Uuid

  fullName String

  relationship String

  email String?

  phone String?

  isPrimaryContact Boolean @default(false)

  legalRepresentative Boolean @default(false)

  notes String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  resident Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([facilityId, residentId])
  @@index([residentId, isPrimaryContact])
}

//////////////////////////////////////////////////////////
// RESIDENT CONTACT
//////////////////////////////////////////////////////////

model ResidentContact {
  id String @id @default(uuid()) @db.Uuid

  residentId String @db.Uuid

  fullName String

  relationship String

  phone String?

  email String?

  isPrimary Boolean @default(false)

  legalRepresentative Boolean @default(false)

  notes String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  resident Resident @relation(fields: [residentId], references: [id], onDelete: Restrict)

  @@index([residentId])
}

//////////////////////////////////////////////////////////
// AUTH.JS
//////////////////////////////////////////////////////////

model Account {
  id String @id @default(cuid())

  userId String @db.Uuid

  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id String @id @default(cuid())

  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

//////////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////////

model User {
  id String @id @default(uuid()) @db.Uuid

  clientId String? @db.Uuid

  facilityId String? @db.Uuid

  roleId String @db.Uuid

  fullName String

  email String @unique

  emailVerified DateTime?
  image         String?

  password String

  active Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  facility Facility? @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  accounts Account[]
  sessions Session[]

  @@index([clientId])
  @@index([facilityId])
  @@index([roleId])
}

//////////////////////////////////////////////////////////
// ROLES
//////////////////////////////////////////////////////////

model Role {
  id String @id @default(uuid()) @db.Uuid

  clientId String? @db.Uuid

  code String @unique

  name String

  description String?

  isSystem Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  users User[]

  permissions RolePermission[]

  @@index([clientId])
}

//////////////////////////////////////////////////////////
// PERMISSIONS
//////////////////////////////////////////////////////////

model Permission {
  id String @id @default(uuid()) @db.Uuid

  code String @unique

  name String

  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles RolePermission[]
}

//////////////////////////////////////////////////////////
// ROLE PERMISSION
//////////////////////////////////////////////////////////

model RolePermission {
  id String @id @default(uuid()) @db.Uuid

  roleId String @db.Uuid

  permissionId String @db.Uuid

  createdAt DateTime @default(now())

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}
